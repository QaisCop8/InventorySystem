# PostgreSQL container. DATABASE_URL connects only to management; tenant names live in management.
POSTGRES_DB=management
POSTGRES_USER=asas_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_PASSWORD
DATABASE_URL=postgresql://asas_app:REPLACE_WITH_A_LONG_URL_SAFE_PASSWORD@database:5432/management

# Required for absolute links generated by background jobs and notifications.
NEXT_PUBLIC_APP_URL=https://asas.com

# Required to protect /api/cron/check-inventory.
CRON_SECRET=replace-with-a-long-random-secret

# Optional integrations. Add only the services used in production.
OPENAI_API_KEY=
XAI_API_KEY=
ENCRYPTION_KEY=
SMTP_FROM=
SMTP_USER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
WHATSAPP_VERIFY_TOKEN=
