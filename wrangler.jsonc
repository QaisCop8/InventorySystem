{
  "$schema": "node_modules/wrangler/config-schema.json",
  // يجب أن يطابق اسم الـ Worker في لوحة Cloudflare
  "name": "inventorysystem",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-15",
  // nodejs_compat مطلوب لـ Next.js ولمكتبة pg (اتصال Postgres)
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "inventorysystem"
    }
  ],
  // يُشغِّل الـ Worker قرب قاعدة البيانات (Neon) بدل قرب المستخدم — كل صفحة تنفّذ عشرات الاستعلامات المتتالية
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true
  }
}
